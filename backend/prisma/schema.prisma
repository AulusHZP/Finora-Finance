generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id                   String        @id @default(uuid())
  name                 String
  email                String        @unique
  password             String        @default("")
  balanceOffset        Decimal       @db.Decimal(12, 2) @default(0)
  creditCardClosingDay Int?
  createdAt            DateTime      @default(now())

  categories           Category[]
  transactions         Transaction[]
  budgets              MonthlyBudget[]
  goals                Goal[]
  refreshTokens        RefreshToken[]
}

// ─────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────

model Category {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  /// Lucide icon name, e.g. "utensils", "car", "home"
  icon      String   @default("tag")
  /// Hex color, e.g. "#10B981"
  color     String   @default("#6B7280")
  /// true = created by seed, not deletable
  isSystem  Boolean  @default(false)
  /// true = this category represents income (only one per user: "Receitas")
  isIncome  Boolean  @default(false)

  createdAt DateTime @default(now())

  transactions   Transaction[]
  categoryBudgets CategoryBudget[]

  @@unique([userId, name])
}

// ─────────────────────────────────────────────
// TRANSACTION
// ─────────────────────────────────────────────

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  description String
  /// Always positive. Income vs expense is determined by category.isIncome.
  /// Stored as Decimal to avoid float rounding errors (R$ 0.1 + R$ 0.2 ≠ R$ 0.3 in Float).
  amount      Decimal  @db.Decimal(12, 2)
  /// YYYY-MM-DD local date. No time, no timezone. Stored as string to avoid UTC drift.
  date        String

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
}

// ─────────────────────────────────────────────
// BUDGET (monthly)
// ─────────────────────────────────────────────

model MonthlyBudget {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  year  Int
  month Int /// 1–12

  /// Total spending ceiling for the month. NULL = no general limit set.
  totalLimit      Decimal? @db.Decimal(12, 2)
  /// Percentage (0–100) at which a warning is triggered.
  alertThreshold  Int      @default(80)

  createdAt DateTime @default(now())

  categoryBudgets CategoryBudget[]

  @@unique([userId, year, month])
  @@index([userId])
}

model CategoryBudget {
  id              String        @id @default(uuid())
  monthlyBudgetId String
  monthlyBudget   MonthlyBudget @relation(fields: [monthlyBudgetId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// NULL = no limit defined for this category ("Defina um limite para acompanhar").
  /// Never 0 — 0 would cause division-by-zero in usage% calculation.
  limitAmount Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([monthlyBudgetId, categoryId])
}

// ─────────────────────────────────────────────
// GOAL
// ─────────────────────────────────────────────

model Goal {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  /// Lucide icon name, e.g. "shield", "plane", "home"
  icon         String
  /// Target savings amount. Must be > 0.
  targetAmount Decimal  @db.Decimal(12, 2)
  /// Optional deadline date (YYYY-MM-DD string, local date).
  deadline     String?
  /// Auto-set to true when sum(contributions) >= targetAmount.
  isCompleted  Boolean  @default(false)

  createdAt DateTime @default(now())

  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id     String @id @default(uuid())
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)
  /// YYYY-MM-DD local date string.
  date   String
  note   String?

  createdAt DateTime @default(now())

  @@index([goalId])
}

// ─────────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
